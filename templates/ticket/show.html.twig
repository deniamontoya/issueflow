{#  Esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}

{# Usamos el código del ticket para construir un título de página específico. #}
{% block title %}{{ ticket.code }} . Issueflow{% endblock %}

{% block body %}
    <p>
        <a href="{{ path('app_ticket_index') }}">Volver a incidencias</a>
    </p>
    <p class="ticket-code">{{ ticket.code }}</p>
    <h1>{{ ticket.title }}</h1>
    <p>Prioridad: <strong>{{ ticket.priority.label }}</strong></p>
    <p>Estado: <strong>{{ ticket.status.label }}</strong></p>
     <p>
            Categoria:
            {# Antes de intentar acceder al name de category;, tengo qur verificar
           que category no sea nulo (si no esta verificacion puede ocurrir un error)
            #} 
            {% if ticket.category %}
                {{ ticket.category.name }}
            {% else %}
                Sin categoría
            {% endif %}
        </p>
        <p>
            Asignado a:
           {# Antes de intentar acceder al name de assignee, tengo qur verificar
           que assignee no sea nulo (si no esta verificacion puede ocurrir un error)
            #} 
            {% if ticket.assignee %}
               {{ ticket.assignee.name }} 
            {% else %}
               Sin asignar
            {% endif %}
        </p>
    {# Agregamos el tiempo de respuesta #}
    <p>Objetivo de respuesta: <strong>{{ responseTargetHours }} horas</strong></p>
     {#
      Agregamos el mensaje "Requiere atención inmediata" solo
        si el ticket tiene una prioridad urgente: TicketPriority::Urgent
        Todo lo que esté entre el {% if condición %} y {% endif %} aparece
        en el documento html solo si se cumple la condición
    #}
    {% if ticket.urgent %}
        <p class="ticket-urgent">Requiere atención inmediata</p>
    {% endif %}
    {# 
        Agregamos el mensaje "Incidencia cerrada" solo
        si el ticket tiene un estado 'closed'
    #}
    {% if ticket.closed %}
        <p class="ticket-closed">Incidencia cerrada</p>
    {% endif %}
{% endblock %}