{# 
fragmento reutilizable para presentar una incidencia dentro de una lista.
el guion bajo inicial es una convencion habitual para indicar que este archivo
es un parcial y no una pagina completa.
  #}
<article class="ticket-card">
  <div>
        <p class="ticket-id">{{ ticket.id }}</p>
        <h2>{{ ticket.title }}</h2>
        <p>Prioridad: <strong>{{ ticket.priority.value }}</strong></p>
        <p>Estado: <strong>{{ ticket.status }}</strong></p>
         </div>
         </article>