{# esta plantilla hereda de base.html.twig #}
{% extends "base.html.twig" %}
{#
#}
{% block title %}{{ projecName}}{% endblock %}

{# Inserto el cuerpo de la pagina de inicio #}
{% block body %}
<section>
        <p>IFCT092PO . Proyecto del curso</p>

        {# projectName debe venir desde el controlador #}
        <h1>{{ projectName }}</h1>

        {# message debe venir desde el controlador #}
        <p>{{ message }}</p>
        
        {# Enlace al listado de incidencias #}
        <p><a href="{{ path('app_ticket_index') }}">Ver incidencias</a></p>
    </section>
{% endblock %}
